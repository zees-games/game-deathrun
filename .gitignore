# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
#
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST. gs-bootstrap derives what to link from
# these lines rather than keeping a second copy, because the repository that gains a
# dependency is the repository that has to ignore its link.
/addons/gs_core
/addons/gs_input
/addons/gs_profile
/addons/gs_profiler
/addons/gs_lighting
/addons/gs_entity
/addons/gs_physics
/addons/gs_player
/addons/gs_player_controller
/addons/gs_combat
/addons/gs_match
/addons/gs_weapon
/addons/gs_ui
/addons/gs_settings
/addons/gs_menu
/addons/gs_console
/addons/gs_fx
/addons/gs_net
# gs-sim: optional native library (snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-sim v0.2.12
/addons/gs_sim
/addons/gs_server
/addons/gs_game
/addons/gs_workbench
/addons/gs_chat
/addons/gs_voice
/addons/gs_moderation
/addons/gs_spectate
/addons/gs_audio
/addons/gs_stats
/addons/gs_achievements
/addons/gs_cloud
/addons/gs_auth
/addons/gs_user
/addons/gs_user_avatar
/addons/gs_platform
/addons/gs_map
/addons/gs_vote
/addons/gs_replay
/addons/gs_bot
/addons/gs_spawn
/addons/zee_weapons
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
/addons/gs_props

# The courses are mg-deathrun-maps, a repository and a pack of their own.
# bootstrap-link: mg-deathrun-maps/courses ci
/courses

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/
/addons/gs_team

# tools/bake_lightmaps.sh's bake scenes and the editor's raw output; lightmaps/ is what ships.
/lightbake_work/
/addons/gs_flashlight
/addons/gs_mobile
/addons/gs_bot_record
/addons/gs_sql
/addons/godot-sqlite
/addons/gs_player_class
/addons/gs_server_query
/addons/gs_npc
